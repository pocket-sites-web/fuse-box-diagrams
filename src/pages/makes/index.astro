---
import Base from '../../layouts/Base.astro';
import { getMakes } from '../../lib/data';
const makes = getMakes();
---
<Base title="Fuse Box Diagrams by Make" description="Choose your vehicle make to find clickable fuse box diagrams for every model and year we cover.">
  <section><h1>Fuse box diagrams by make</h1></section>
  <ul class="link-grid">{makes.map((m) => <li><a href={`/${m.makeSlug}/`}>{m.make}<span class="sub">{m.models.length} models</span></a></li>)}</ul>
</Base>
